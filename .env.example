# PostgreSQL credentials for BaaRai/ARTEX
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=artex

# Required for Docker Compose HTTP MCP servers (generate e.g. `openssl rand -hex 32`)
MCP_AUTH_TOKEN=change-me-to-a-random-bearer-token

# Optional: HMAC key for scope-guard-mcp ledger integrity (detects full rewrites/truncation)
SCOPE_LEDGER_HMAC_KEY=

# Optional: ARTEX port override (bound to 127.0.0.1 in docker-compose.yml)
ARTEX_PORT=8787

# Optional: LLM provider settings (OpenAI, Anthropic, OpenRouter, Ollama, or any OpenAI-compatible API)
# OPENAI_API_KEY=your-api-key
# ARTEX_LLM_PROVIDER=openai
# ARTEX_LLM_BASE_URL=https://api.openai.com/v1
# ARTEX_LLM_MODEL=gpt-4.1-mini

# Optional: GitHub token to raise patch-diff-mcp API rate limits (only sent to api.github.com)
GITHUB_TOKEN=

# Optional: scope policy filename inside ./config to preload into scope-guard-mcp on startup
SCOPE_DEFAULT_POLICY=

# Optional: comma-separated CORS origins allowed to call nexus-console (:8088)
NEXUS_CORS_ORIGINS=http://127.0.0.1:8787,http://localhost:8787

# Optional: ARTEX egress rate-limit profile (quiet, moderate, off)
ARTEX_NOISE_PROFILE=quiet
