# Copy to .env and fill in values before running `docker compose up -d`
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=artex
ARTEX_PORT=8787

# Optional: GitHub personal access token (public_repo read-only) for higher patch-diff-mcp rate limits
GITHUB_TOKEN=

# ARTEX LLM configuration (leave blank to configure in the UI)
# Example for Vultr Serverless Inference (OpenAI-compatible + tool calling):
# ARTEX_LLM_PROVIDER=openai
# ARTEX_LLM_BASE_URL=https://api.vultrinference.com/v1
# ARTEX_LLM_MODEL=glm-5.3
# OPENAI_API_KEY=your-vultr-or-openai-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=

# Target request pacing and run budget controls
ARTEX_NOISE_PROFILE=quiet
ARTEX_TASK_BUDGET_TOKENS=500000
ARTEX_TASK_BUDGET_TURNS=
ARTEX_INTENT_BUDGET_TOKENS=
ARTEX_INTENT_BUDGET_TURNS=
